{
  "metadata": {
    "name": "Named section selector extracts Goal",
    "schemaVersion": 1
  },
  "nodes": [
    {
      "id": "input-1",
      "kind": "input",
      "label": "Markdown in",
      "position": { "x": 0, "y": 0 },
      "settings": {
        "mediaType": "text/markdown",
        "content": "# Brief\n\n## Goal\nShip Phase 26 selectors.\n\n## Constraints\nNo LLM calls.\n"
      }
    },
    {
      "id": "skill-1",
      "kind": "skill",
      "label": "EmitMarkdown",
      "position": { "x": 220, "y": 0 },
      "settings": {
        "description": "Echo markdown for named-section tests",
        "joinPolicy": "wait_for_all"
      }
    },
    {
      "id": "output-1",
      "kind": "artifactOutput",
      "label": "Goal section",
      "position": { "x": 440, "y": 0 },
      "settings": {
        "mode": "selector",
        "destination": "preview",
        "selectorKind": "namedSection",
        "selectorExpression": "Goal",
        "missingDataPolicy": "fail"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "dataFlow",
      "sourceNodeId": "input-1",
      "targetNodeId": "skill-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    },
    {
      "id": "e2",
      "kind": "dataFlow",
      "sourceNodeId": "skill-1",
      "targetNodeId": "output-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    }
  ]
}
