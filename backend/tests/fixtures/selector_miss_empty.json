        "mode": "selector",
        "destination": "preview",
        "selectorKind": "jsonPath",
        "selectorExpression": "$.output.missing",
        "missingDataPolicy": "empty"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "dataFlow",
      "sourceNodeId": "input-1",
      "targetNodeId": "skill-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    },
    {
      "id": "e2",
      "kind": "dataFlow",
      "sourceNodeId": "skill-1",
      "targetNodeId": "output-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    }
  ]
