{
  "metadata": {
    "name": "Pass-through + selector fan-out (zero extra runner calls)",
    "schemaVersion": 1
  },
  "nodes": [
    {
      "id": "input-1",
      "kind": "input",
      "label": "JSON in",
      "position": { "x": 0, "y": 0 },
      "settings": {
        "mediaType": "application/json",
        "content": "{\"output\":{\"headline\":\"Extract me with JSONPath\",\"body\":\"full body\"}}"
      }
    },
    {
      "id": "skill-1",
      "kind": "skill",
      "label": "EmitJSON",
      "position": { "x": 220, "y": 0 },
      "settings": {
        "description": "Echo JSON",
        "joinPolicy": "wait_for_all"
      }
    },
    {
      "id": "output-1",
      "kind": "artifactOutput",
      "label": "Full",
      "position": { "x": 440, "y": -60 },
      "settings": {
        "mode": "pass-through",
        "destination": "preview"
      }
    },
    {
      "id": "output-2",
      "kind": "artifactOutput",
      "label": "Headline only",
      "position": { "x": 440, "y": 60 },
      "settings": {
        "mode": "selector",
        "destination": "preview",
        "selectorKind": "jsonPath",
        "selectorExpression": "$.output.headline",
        "missingDataPolicy": "fail"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "kind": "dataFlow",
      "sourceNodeId": "input-1",
      "targetNodeId": "skill-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    },
    {
      "id": "e2",
      "kind": "dataFlow",
      "sourceNodeId": "skill-1",
      "targetNodeId": "output-1",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    },
    {
      "id": "e3",
      "kind": "dataFlow",
      "sourceNodeId": "skill-1",
      "targetNodeId": "output-2",
      "sourcePortId": "data-out",
      "targetPortId": "data-in"
    }
  ]
}
